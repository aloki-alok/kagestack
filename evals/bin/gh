#!/usr/bin/env python3
import base64
import contextlib
import io
import json
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'gh'
ORIGIN = ROOT / 'origin.git'
args = sys.argv[1:]
line = ' '.join(args)
command = ' '.join(args[:2])
with open(OUT / 'gh.log', 'a') as log:
    log.write(line + '\n')


def values(*names):
    return [args[i + 1] for i, arg in enumerate(args[:-1]) if arg in names]


def option(*names):
    return next(iter(values(*names)), None)


def read(path):
    return sys.stdin.read() if path == '-' else Path(path).read_text()


def body():
    if args[:1] == ['api']:
        if path := option('--input'):
            data = read(path)
            with contextlib.suppress(ValueError, AttributeError):
                return json.loads(data).get('body', data)
            return data
        fields = values('-f', '-F', '--field', '--raw-field')
        return dict(f.split('=', 1) for f in fields if '=' in f).get('body')
    if path := option('--body-file', '-F'):
        return read(path)
    return option('--body', '-b')


def append(name, record):
    with open(OUT / name, 'a') as f:
        f.write(json.dumps(record) + '\n')


def current_branch():
    return subprocess.run(
        ['git', 'branch', '--show-current'],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()


def repo_name():
    url = subprocess.run(
        ['git', 'remote', 'get-url', 'origin'],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    return url.rstrip('/').removesuffix('.git').rsplit('/', 1)[-1] or 'repo'


def server_file(name, default):
    path = OUT / name
    return json.loads(path.read_text()) if path.exists() else default


def org_repo(endpoint):
    if not (OUT / 'org-template.md').exists():
        return None
    return {
        'repos/acme/.github': {
            'name': '.github',
            'full_name': 'acme/.github',
            'default_branch': 'main',
        },
        'repos/acme/.github/contents': [
            {'name': '.github', 'path': '.github', 'type': 'dir'}
        ],
        'repos/acme/.github/contents/.github': [
            {
                'name': 'pull_request_template.md',
                'path': '.github/pull_request_template.md',
                'type': 'file',
            }
        ],
    }.get(endpoint.strip('/'))


def not_found():
    print('{"message":"Not Found","status":"404"}')
    print('gh: Not Found (HTTP 404)', file=sys.stderr)
    sys.exit(1)


def ci(pr):
    head = subprocess.run(
        ['git', '--git-dir', ORIGIN, 'rev-parse', pr['headRefName']],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    archive = subprocess.run(
        ['git', '--git-dir', ORIGIN, 'archive', head], capture_output=True, check=False
    )
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run(['tar', '-x', '-C', tmp], input=archive.stdout, check=False)
        tests = subprocess.run(
            [sys.executable, '-m', 'unittest', '-q'],
            cwd=tmp,
            capture_output=True,
            text=True,
            check=False,
        )
        log = tests.stderr.replace(tmp, f'/home/runner/work/{name}/{name}')
    passed = tests.returncode == 0
    append('ci.jsonl', {'head': head, 'passed': passed})
    return passed, log


def open_pr(pr):
    passed, log = ci(pr)
    comments = server_file('comments.json', [])
    conclusion = 'SUCCESS' if passed else 'FAILURE'
    run_url = f'{url}/actions/runs/4242'
    if command == 'pr checks':
        if '--json' in args:
            bucket = 'pass' if passed else 'fail'
            print(json.dumps([{'name': 'test', 'bucket': bucket, 'link': run_url}]))
        else:
            print(f'test\t{"pass" if passed else "fail"}\t21s\t{run_url}')
        sys.exit(0 if passed else 1)
    if command == 'pr view' and '--json' in args:
        print(
            json.dumps(
                {
                    **pr,
                    'url': f'{url}/pull/{pr["number"]}',
                    'state': 'OPEN',
                    'isDraft': False,
                    'mergeStateStatus': 'CLEAN' if passed else 'BLOCKED',
                    'reviewDecision': 'REVIEW_REQUIRED',
                    'statusCheckRollup': [
                        {
                            'name': 'test',
                            'conclusion': conclusion,
                            'detailsUrl': run_url,
                        }
                    ],
                    'comments': [
                        {'author': {'login': c['user']}, 'body': c['body']}
                        for c in comments
                    ],
                }
            )
        )
    elif command == 'pr view':
        print(f'{pr["title"]} acme/{name}#{pr["number"]}\nOpen\n\n{pr["body"]}\n')
        for c in comments:
            print(f'{c["user"]} ({c["path"]}:{c["line"]}):\n{c["body"]}\n')
    elif command == 'pr list':
        print(json.dumps([{**pr, 'url': f'{url}/pull/{pr["number"]}'}]))
    elif command == 'run list':
        print(json.dumps([{'databaseId': 4242, 'conclusion': conclusion.lower()}]))
    elif command == 'run view':
        print(f'test\tRun tests\t{log}')
    elif command == 'pr merge':
        (OUT / 'merge.txt').write_text(line)
        print(f'Merged pull request acme/{name}#{pr["number"]}')
    elif args[:1] == ['api'] and 'graphql' in args and 'mutation' not in line:
        threads = [
            {
                'id': f'T{c["id"]}',
                'isResolved': False,
                'comments': {
                    'nodes': [
                        {
                            'databaseId': c['id'],
                            'body': c['body'],
                            'author': {'login': c['user']},
                            'path': c['path'],
                            'line': c['line'],
                        }
                    ]
                },
            }
            for c in comments
        ]
        pull = {'reviewThreads': {'nodes': threads}}
        print(json.dumps({'data': {'repository': {'pullRequest': pull}}}))
    elif command in ('pr comment', 'pr review') or (
        args[:1] == ['api']
        and ('graphql' in args or {'POST', '-f', '-F', '--input'} & set(args))
    ):
        append('replies.jsonl', {'args': args, 'body': body()})
        print('{"data": {}}' if 'graphql' in args else '{}')
    elif args[:1] == ['api'] and '/comments' in line:
        print(json.dumps(comments))
    else:
        return False
    return True


def main():
    pr = server_file('pr.json', None)
    serves_pr = args[:1] in (['pr'], ['run']) or (
        args[:1] == ['api'] and 'template' not in line
    )
    if pr and serves_pr and open_pr(pr):
        sys.exit(0)
    created = OUT / 'pr-create.json'
    if command == 'auth status':
        print('github.com\n  ✓ Logged in to github.com account dev (keyring)')
    elif command == 'repo view':
        viewed = args[2] if len(args) > 2 and '/' in args[2] else f'acme/{name}'
        print(
            json.dumps(
                {
                    'name': viewed.rsplit('/', 1)[-1],
                    'nameWithOwner': viewed,
                    'owner': {'login': 'acme'},
                    'defaultBranchRef': {'name': 'main'},
                    'url': f'https://github.com/{viewed}',
                }
            )
        )
    elif command == 'pr create':
        head = (option('--head', '-H') or current_branch()).rsplit(':', 1)[-1]
        pushed = subprocess.run(
            ['git', '--git-dir', ORIGIN, 'rev-parse', '-q', '--verify', head],
            capture_output=True,
            check=False,
        )
        if pushed.returncode:
            print(
                'aborted: you must first push the current branch to a remote, '
                'or use the --head flag',
                file=sys.stderr,
            )
            sys.exit(1)
        created.write_text(json.dumps({'args': args, 'head': head}))
        if (text := body()) is not None:
            (OUT / 'pr-body.md').write_text(text)
        print(f'{url}/pull/12')
    elif command == 'pr edit':
        if (text := body()) is not None:
            (OUT / 'pr-body.md').write_text(text)
        print(f'{url}/pull/12')
    elif command in ('pr view', 'pr list'):
        if not created.exists():
            if command == 'pr list':
                print('[]')
                sys.exit(0)
            print('no pull requests found for branch', file=sys.stderr)
            sys.exit(1)
        body_file = OUT / 'pr-body.md'
        flags = json.loads(created.read_text())['args']
        pr = {
            'number': 12,
            'url': f'{url}/pull/12',
            'state': 'OPEN',
            'isDraft': '--draft' in flags or '-d' in flags,
            'body': body_file.read_text() if body_file.exists() else '',
        }
        print(json.dumps([pr] if command == 'pr list' else pr))
    elif command in ('issue list', 'search issues'):
        found = server_file('issues.json', [])
        if '--json' in args:
            print(
                json.dumps([{**i, 'url': f'{url}/issues/{i["number"]}'} for i in found])
            )
        else:
            for i in found:
                print(f'{i["number"]}\t{i["state"]}\t{i["title"]}')
    elif command == 'issue view':
        number = int(args[2].rsplit('/', 1)[-1].lstrip('#'))
        match = [i for i in server_file('issues.json', []) if i['number'] == number]
        i = match[0] if match else not_found()
        print(
            f'title:\t{i["title"]}\nstate:\t{i["state"]}\nnumber:\t{number}\n--\n{i["body"]}'
        )
    elif command == 'issue create':
        append('issues-created.jsonl', {'args': args, 'body': body()})
        count = len((OUT / 'issues-created.jsonl').read_text().splitlines())
        print(f'{url}/issues/{100 + count}')
    elif command == 'issue comment':
        append('issue-comments.jsonl', {'args': args, 'body': body()})
        print(f'{url}/issues/{args[2]}#issuecomment-1')
    elif args[:1] == ['api'] and 'pull_request_template' in line.lower():
        template = OUT / 'org-template.md'
        if '/.github/contents' not in line or not template.exists():
            not_found()
        text = template.read_text()
        if 'raw' in line:
            print(text)
        else:
            encoded = base64.b64encode(text.encode()).decode()
            print(
                json.dumps(
                    {
                        'name': 'pull_request_template.md',
                        'encoding': 'base64',
                        'content': encoded,
                    }
                )
            )
    elif args[:1] == ['api'] and (
        listing := org_repo(next((a for a in args[1:] if 'repos/' in a), ''))
    ):
        print(json.dumps(listing))
    elif args[:1] == ['api']:
        not_found()
    else:
        print('[]')


name = repo_name()
url = f'https://github.com/acme/{name}'
buffer = io.StringIO()
code = 0
with contextlib.redirect_stdout(buffer):
    try:
        main()
    except SystemExit as stop:
        code = stop.code or 0
text = buffer.getvalue()
if (expr := option('--jq', '-q')) and code == 0 and text.strip():
    done = subprocess.run(
        ['jq', '-r', expr], input=text, capture_output=True, text=True, check=False
    )
    text, code = done.stdout, done.returncode
    sys.stderr.write(done.stderr)
sys.stdout.write(text)
sys.exit(code)
