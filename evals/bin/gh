#!/usr/bin/env python3
import base64
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

OUT = Path(os.environ['EVAL_OUT'])
EVAL = Path(os.environ['EVAL_DIR'])
args = sys.argv[1:]
line = ' '.join(args)
with open(OUT / 'gh.log', 'a') as log:
    log.write(line + '\n')


def option(*names):
    for i, arg in enumerate(args[:-1]):
        if arg in names:
            return args[i + 1]
    return None


def body():
    if path := option('--body-file', '-F'):
        return Path(path).read_text()
    return option('--body', '-b')


def append(name, record):
    with open(OUT / name, 'a') as f:
        f.write(json.dumps(record) + '\n')


def repo_name():
    url = subprocess.run(
        ['git', 'remote', 'get-url', 'origin'],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    return url.rstrip('/').removesuffix('.git').rsplit('/', 1)[-1] or 'repo'


def issues():
    path = EVAL / 'issues.json'
    return json.loads(path.read_text()) if path.exists() else []


def not_found():
    print('{"message":"Not Found","status":"404"}')
    sys.exit(1)


def ci(pr):
    remote = os.environ['EVAL_REMOTE_PATH']
    head = subprocess.run(
        ['git', '--git-dir', remote, 'rev-parse', pr['headRefName']],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    archive = subprocess.run(
        ['git', '--git-dir', remote, 'archive', head], capture_output=True, check=False
    )
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run(['tar', '-x', '-C', tmp], input=archive.stdout, check=False)
        tests = subprocess.run(
            [sys.executable, '-m', 'unittest', '-q'],
            cwd=tmp,
            capture_output=True,
            text=True,
            check=False,
        )
        log = tests.stderr.replace(tmp, f'/home/runner/work/{name}/{name}')
    passed = tests.returncode == 0
    append('ci.jsonl', {'head': head, 'passed': passed})
    return passed, log


def review_comments():
    path = EVAL / 'comments.json'
    return json.loads(path.read_text()) if path.exists() else []


def open_pr(pr):
    passed, log = ci(pr)
    conclusion = 'SUCCESS' if passed else 'FAILURE'
    run_url = f'{url}/actions/runs/4242'
    if command == 'pr checks':
        if '--json' in args:
            bucket = 'pass' if passed else 'fail'
            print(json.dumps([{'name': 'test', 'bucket': bucket, 'link': run_url}]))
        else:
            print(f'test\t{"pass" if passed else "fail"}\t21s\t{run_url}')
        sys.exit(0 if passed else 1)
    if command == 'pr view' and '--json' in args:
        print(
            json.dumps(
                {
                    **pr,
                    'url': f'{url}/pull/{pr["number"]}',
                    'state': 'OPEN',
                    'isDraft': False,
                    'mergeStateStatus': 'CLEAN' if passed else 'BLOCKED',
                    'reviewDecision': 'REVIEW_REQUIRED',
                    'statusCheckRollup': [
                        {'name': 'test', 'conclusion': conclusion, 'detailsUrl': run_url}
                    ],
                    'comments': [
                        {'author': {'login': c['user']}, 'body': c['body']}
                        for c in review_comments()
                    ],
                }
            )
        )
    elif command == 'pr view':
        print(f'{pr["title"]} acme/{name}#{pr["number"]}\nOpen\n\n{pr["body"]}\n')
        for c in review_comments():
            print(f'{c["user"]} ({c["path"]}:{c["line"]}):\n{c["body"]}\n')
    elif command == 'pr list':
        print(json.dumps([{**pr, 'url': f'{url}/pull/{pr["number"]}'}]))
    elif command == 'run list':
        print(json.dumps([{'databaseId': 4242, 'conclusion': conclusion.lower()}]))
    elif command == 'run view':
        print(f'test\tRun tests\t{log}')
    elif command == 'pr merge':
        (OUT / 'merge.txt').write_text(line)
        print(f'Merged pull request acme/{name}#{pr["number"]}')
    elif command in ('pr comment', 'pr review') or (
        args[:1] == ['api'] and ('POST' in args or '-f' in args or '--input' in args)
    ):
        append('replies.jsonl', {'args': line, 'body': body()})
        print('{}')
    elif args[:1] == ['api'] and 'graphql' in args:
        threads = [
            {
                'id': f'T{c["id"]}',
                'isResolved': False,
                'comments': {
                    'nodes': [
                        {
                            'databaseId': c['id'],
                            'body': c['body'],
                            'author': {'login': c['user']},
                            'path': c['path'],
                            'line': c['line'],
                        }
                    ]
                },
            }
            for c in review_comments()
        ]
        pull = {'reviewThreads': {'nodes': threads}}
        print(json.dumps({'data': {'repository': {'pullRequest': pull}}}))
    elif args[:1] == ['api'] and '/comments' in line:
        print(json.dumps(review_comments()))
    else:
        return False
    return True


command = ' '.join(args[:2])
name = repo_name()
url = f'https://github.com/acme/{name}'
pr_file = EVAL / 'pr.json'
if pr_file.exists() and (
    args[:1] in (['pr'], ['run']) or args[:1] == ['api'] and 'template' not in line
):
    if open_pr(json.loads(pr_file.read_text())):
        sys.exit(0)
if command == 'repo view':
    print(
        json.dumps(
            {
                'name': name,
                'nameWithOwner': f'acme/{name}',
                'owner': {'login': 'acme'},
                'defaultBranchRef': {'name': 'main'},
                'url': url,
            }
        )
    )
elif command == 'pr create':
    (OUT / 'pr-create.txt').write_text(line)
    if (text := body()) is not None:
        (OUT / 'pr-body.md').write_text(text)
    print(f'{url}/pull/12')
elif command == 'pr edit':
    if (text := body()) is not None:
        (OUT / 'pr-body.md').write_text(text)
    print(f'{url}/pull/12')
elif command in ('pr view', 'pr list'):
    created = OUT / 'pr-create.txt'
    if not created.exists():
        if command == 'pr list':
            print('[]')
            sys.exit(0)
        print('no pull requests found for branch', file=sys.stderr)
        sys.exit(1)
    text = (OUT / 'pr-body.md').read_text() if (OUT / 'pr-body.md').exists() else ''
    pr = {
        'number': 12,
        'url': f'{url}/pull/12',
        'state': 'OPEN',
        'isDraft': '--draft' in created.read_text(),
        'body': text,
    }
    print(json.dumps([pr] if command == 'pr list' else pr))
elif command in ('issue list', 'search issues'):
    found = issues()
    if '--json' in args:
        print(json.dumps([{**i, 'url': f'{url}/issues/{i["number"]}'} for i in found]))
    else:
        for i in found:
            print(f'{i["number"]}\t{i["state"]}\t{i["title"]}')
elif command == 'issue view':
    number = int(args[2].rsplit('/', 1)[-1].lstrip('#'))
    match = [i for i in issues() if i['number'] == number] or not_found()
    i = match[0]
    print(
        f'title:\t{i["title"]}\nstate:\t{i["state"]}\nnumber:\t{number}\n--\n{i["body"]}'
    )
elif command == 'issue create':
    append('issues-created.jsonl', {'args': line, 'body': body()})
    count = len((OUT / 'issues-created.jsonl').read_text().splitlines())
    print(f'{url}/issues/{100 + count}')
elif command == 'issue comment':
    append('issue-comments.jsonl', {'args': line, 'body': body()})
    print(f'{url}/issues/{args[2]}#issuecomment-1')
elif args[:1] == ['api'] and 'pull_request_template' in line.lower():
    template = EVAL / 'org-template.md'
    if '/.github/contents' not in line or not template.exists():
        not_found()
    text = template.read_text()
    encoded = base64.b64encode(text.encode()).decode()
    if 'raw' in line:
        print(text)
    elif '--jq' in args:
        print(encoded)
    else:
        print(
            json.dumps(
                {
                    'name': 'pull_request_template.md',
                    'encoding': 'base64',
                    'content': encoded,
                }
            )
        )
elif args[:1] == ['api']:
    not_found()
else:
    print('[]')
