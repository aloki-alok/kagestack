#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys

here = os.path.dirname(os.path.abspath(__file__))
path = os.pathsep.join(
    p for p in os.environ['PATH'].split(os.pathsep) if os.path.abspath(p) != here
)
real = shutil.which('git', path=path)
args = sys.argv[1:]
remote, local = os.environ.get('EVAL_REMOTE'), os.environ.get('EVAL_REMOTE_PATH')
if not (remote and local and set(args) & {'push', 'fetch', 'pull', 'ls-remote'}):
    os.execv(real, [real, *args])
done = subprocess.run(
    [real, '-c', f'url.{local}.insteadOf={remote}', *args],
    capture_output=True,
    text=True,
)
sys.stdout.write(done.stdout.replace(local, remote))
sys.stderr.write(done.stderr.replace(local, remote))
sys.exit(done.returncode)
