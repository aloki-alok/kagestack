#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
path = os.pathsep.join(
    p for p in os.environ['PATH'].split(os.pathsep) if Path(p).resolve() != here
)
real = shutil.which('git', path=path)
remote = (here.parent / 'gh' / 'remote').read_text().strip()
local = str(here.parent / 'origin.git')
done = subprocess.run(
    [real, '-c', f'url.{local}.insteadOf={remote}', *sys.argv[1:]],
    capture_output=True,
    check=False,
)
sys.stdout.buffer.write(done.stdout.replace(local.encode(), remote.encode()))
sys.stderr.buffer.write(done.stderr.replace(local.encode(), remote.encode()))
sys.exit(done.returncode)
