{
  "description": "give plain worker subagents the worker rules, and review new commits when an interactive turn ends",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(claude|general-purpose|Explore|Plan)$",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/worker.json\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/review.sh\""
          }
        ]
      }
    ]
  }
}
