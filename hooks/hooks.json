{
  "description": "give every subagent the worker rules when it starts",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; print(json.dumps({'hookSpecificOutput': {'hookEventName': 'SubagentStart', 'additionalContext': open(sys.argv[1]).read()}}))\" \"${CLAUDE_PLUGIN_ROOT}/hooks/worker.md\""
          }
        ]
      }
    ]
  }
}
