{
  "description": "give plain worker subagents the worker rules when they start",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(claude|general-purpose|Explore|Plan)$",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/worker.json\""
          }
        ]
      }
    ]
  }
}
